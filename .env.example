DATABASE_URL=postgresql://aristoteles:aristoteles@localhost:5432/aristoteles?schema=public
PORT=3000

# Generate with: openssl rand -hex 32
JWT_SECRET=
# Set to production behind HTTPS to enable secure cookies
NODE_ENV=development

# Storage provider: local or prd
APP_ENV=local

# Required when APP_ENV=prd. Credentials are resolved by the AWS SDK default
# provider chain (for example, an IAM role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
AWS_REGION=
AWS_S3_BUCKET=
