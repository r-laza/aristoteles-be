# For NestJS running directly on the host. The development Compose file publishes
# PostgreSQL on the loopback interface only.
DATABASE_URL=postgresql://aristoteles:aristoteles@127.0.0.1:5432/aristoteles?schema=public
PORT=3000

# Generate with: openssl rand -hex 32
JWT_SECRET=
# Set to production behind HTTPS to enable secure cookies
NODE_ENV=development

# Storage provider: local or prd
APP_ENV=local

# Required when APP_ENV=prd. Credentials are resolved by the AWS SDK default
# provider chain (for example, an IAM role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
AWS_REGION=
AWS_S3_BUCKET=

# WhatsApp reminders. AWS credentials are resolved through the default SDK
# credential chain; use an IAM role in production.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=aws
WHATSAPP_REMINDER_DAYS=2
WHATSAPP_SENDER_ID=
WHATSAPP_TEMPLATE_NAME=
ACADEMY_NAME=Academia Aristóteles
