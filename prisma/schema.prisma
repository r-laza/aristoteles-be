generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  initials    String
  enrollments CourseEnrollment[]
  activities  Activity[]
}

model Course {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  teacher     String
  image       String             @default("/images/course-placeholder.jpg")
  enrollments CourseEnrollment[]
  tasks       Task[]
  activities  Activity[]
}

model CourseEnrollment {
  id        Int     @id @default(autoincrement())
  studentId Int
  courseId  Int
  progress  Int     @default(0)
  student   Student @relation(fields: [studentId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("Enrollment")
}

model Task {
  id       Int      @id @default(autoincrement())
  courseId Int
  title    String
  dueAt    DateTime
  status   String   @default("pending")
  course   Course   @relation(fields: [courseId], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int?
  title     String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  course    Course?  @relation(fields: [courseId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  enrollments  Enrollment[]
  id           Int          @id @default(autoincrement())
  username     String       @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AcademicCycle {
  id                   Int          @id @default(autoincrement())
  name                 String
  startDate            DateTime     @db.Date
  endDate              DateTime     @db.Date
  baseEnrollmentAmount Decimal      @db.Decimal(12, 2)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  groups               Group[]
  enrollments          Enrollment[]
}

model Group {
  id              Int           @id @default(autoincrement())
  name            String
  academicCycleId Int
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  enrollments     Enrollment[]

  @@unique([academicCycleId, name])
  @@unique([id, academicCycleId])
}

enum EnrollmentStatus {
  ACTIVE
}

model Enrollment {
  payments        Payment[]
  id              Int              @id @default(autoincrement())
  studentId       Int
  student         User             @relation(fields: [studentId], references: [id])
  academicCycleId Int
  academicCycle   AcademicCycle    @relation(fields: [academicCycleId], references: [id])
  groupId         Int
  group           Group            @relation(fields: [groupId, academicCycleId], references: [id, academicCycleId])
  baseAmount      Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  discountReason  String?
  finalAmount     Decimal          @db.Decimal(12, 2)
  status          EnrollmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([studentId, academicCycleId])
  @@index([academicCycleId])
  @@index([groupId, academicCycleId])
  @@map("AcademicEnrollment")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Payment {
  id            Int           @id @default(autoincrement())
  enrollmentId  Int
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @db.Date
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([enrollmentId, paymentDate])
}
