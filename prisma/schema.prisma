generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                           Int                  @id @default(autoincrement())
  fullName                     String
  initials                     String
  dni                          String               @unique
  firstName                    String
  lastName                     String
  birthDate                    DateTime             @db.Date
  gender                       Gender
  representativeName           String
  representativeDocumentType   ReceiptDocumentType?
  representativeDocumentNumber String?
  relationship                 Relationship
  relationshipOther            String?
  primaryPhone                 String
  secondaryPhone               String?
  isActive                     Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  userId                       Int?                 @unique
  user                         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments                  CourseEnrollment[]
  academicEnrollments          Enrollment[]
  activities                   Activity[]
  notificationLogs             NotificationLog[]
  voucherCounters              VoucherCounter[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Relationship {
  FATHER
  MOTHER
  OTHER
}

model Course {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  teacher     String
  image       String             @default("/images/course-placeholder.jpg")
  enrollments CourseEnrollment[]
  tasks       Task[]
  activities  Activity[]
}

model CourseEnrollment {
  id        Int     @id @default(autoincrement())
  studentId Int
  courseId  Int
  progress  Int     @default(0)
  student   Student @relation(fields: [studentId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("Enrollment")
}

model Task {
  id       Int      @id @default(autoincrement())
  courseId Int
  title    String
  dueAt    DateTime
  status   String   @default("pending")
  course   Course   @relation(fields: [courseId], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  studentId Int
  courseId  Int?
  title     String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  course    Course?  @relation(fields: [courseId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role
  adminLevel   AdminLevel @default(REGULAR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student?
  collectedPayments Payment[] @relation("PaymentCollector")
}

enum AdminLevel {
  MAIN
  REGULAR
}

model AcademicCycle {
  feeId           Int?
  fee             EnrollmentFee?        @relation(fields: [feeId], references: [id], onDelete: Restrict)
  id              Int                   @id @default(autoincrement())
  name            String
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  status          AcademicCycleStatus   @default(UPCOMING)
  category        AcademicCycleCategory @default(SCHOOL)
  preuniversityFee Decimal?              @db.Decimal(12, 2)
  preuniversityInstallments Int?
  preuniversityDueRule PreuniversityDueRule?
  groups          CycleGroup[]
  enrollments     Enrollment[]
  branches        AcademicCycleBranch[]
  voucherCounters VoucherCounter[]
}

enum AcademicCycleCategory {
  SCHOOL
  PREUNIVERSITY
}

enum PreuniversityDueRule {
  FIFTEENTH
  LAST_DAY
}

enum AcademicCycleStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model Branch {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  address       String?
  details       String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  cycleGroups   CycleGroup[]
  cycles        AcademicCycleBranch[]
  enrollments   Enrollment[]
  transfersFrom EnrollmentTransfer[]  @relation("PreviousBranch")
  transfersTo   EnrollmentTransfer[]  @relation("NewBranch")
}

model AcademicCycleBranch {
  academicCycleId Int
  branchId        Int
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@id([academicCycleId, branchId])
  @@index([branchId])
}

model Group {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  cycles   CycleGroup[]

  @@map("ReusableGroup")
}

model CycleGroup {
  pensionId       Int?
  pension         Pension?             @relation(fields: [pensionId], references: [id], onDelete: Restrict)
  id              Int                  @id @default(autoincrement())
  reusableGroupId Int
  reusableGroup   Group                @relation(fields: [reusableGroupId], references: [id])
  branchId        Int
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fees            EnrollmentFee[]
  academicCycleId Int
  academicCycle   AcademicCycle        @relation(fields: [academicCycleId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  enrollments     Enrollment[]
  transfersFrom   EnrollmentTransfer[] @relation("PreviousGroup")
  transfersTo     EnrollmentTransfer[] @relation("NewGroup")

  @@unique([academicCycleId, branchId, reusableGroupId])
  @@unique([id, academicCycleId, branchId])
  @@index([branchId])
  @@map("Group")
}

enum EnrollmentStatus {
  ACTIVE
}

model Enrollment {
  enrollmentFeeName      String?
  pensionName            String?
  pensionStartDate       DateTime?            @db.Date
  pensionEndDate         DateTime?            @db.Date
  pensionBaseAmount      Decimal?             @db.Decimal(12, 2)
  pensionDiscountPercent Decimal?             @db.Decimal(5, 2)
  pensionDiscountAmount  Decimal?             @db.Decimal(12, 2)
  pensionAmount          Decimal?             @db.Decimal(12, 2)
  pensionDueDay          Int?
  payments               Payment[]
  pensionObligations     PensionObligation[]
  transfers              EnrollmentTransfer[]
  id                     Int                  @id @default(autoincrement())
  studentId              Int
  student                Student              @relation(fields: [studentId], references: [id])
  academicCycleId        Int
  academicCycle          AcademicCycle        @relation(fields: [academicCycleId], references: [id])
  branchId               Int
  branch                 Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groupId                Int
  group                  CycleGroup           @relation(fields: [groupId, academicCycleId, branchId], references: [id, academicCycleId, branchId])
  feeId                  Int?
  fee                    EnrollmentFee?       @relation(fields: [feeId], references: [id])
  baseAmount             Decimal              @db.Decimal(12, 2)
  discountPercent        Decimal?             @db.Decimal(5, 2)
  discountAmount         Decimal              @default(0) @db.Decimal(12, 2)
  discountReason         String?
  finalAmount            Decimal              @db.Decimal(12, 2)
  status                 EnrollmentStatus     @default(ACTIVE)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([studentId, academicCycleId])
  @@index([academicCycleId])
  @@index([branchId])
  @@index([groupId, academicCycleId])
  @@map("AcademicEnrollment")
}

model EnrollmentTransfer {
  id               Int        @id @default(autoincrement())
  enrollmentId     Int
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  previousBranchId Int
  previousBranch   Branch     @relation("PreviousBranch", fields: [previousBranchId], references: [id], onDelete: Restrict)
  previousGroupId  Int
  previousGroup    CycleGroup @relation("PreviousGroup", fields: [previousGroupId], references: [id], onDelete: Restrict)
  newBranchId      Int
  newBranch        Branch     @relation("NewBranch", fields: [newBranchId], references: [id], onDelete: Restrict)
  newGroupId       Int
  newGroup         CycleGroup @relation("NewGroup", fields: [newGroupId], references: [id], onDelete: Restrict)
  transferDate     DateTime   @db.Date
  reason           String?
  createdAt        DateTime   @default(now())

  @@index([enrollmentId, transferDate])
}

model PensionObligation {
  id               Int               @id @default(autoincrement())
  enrollmentId     Int
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  period           String
  name             String
  baseAmount       Decimal           @db.Decimal(12, 2)
  discountAmount   Decimal           @default(0) @db.Decimal(12, 2)
  amount           Decimal           @db.Decimal(12, 2)
  dueDate          DateTime          @db.Date
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notificationLogs NotificationLog[]

  @@unique([enrollmentId, period])
}

enum NotificationType {
  PENSION_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

model NotificationLog {
  id                Int                @id @default(autoincrement())
  studentId         Int
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  obligationId      Int
  obligation        PensionObligation  @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([obligationId, type])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  YAPE
  PLIN
  OTHER
}

enum PaymentType {
  ENROLLMENT
  PENSION
}

enum ReceiptDocumentType {
  DNI
  CE
  PASSPORT
}

enum ReceiptRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Payment {
  paymentType                 PaymentType          @default(ENROLLMENT)
  period                      String?
  id                          Int                  @id @default(autoincrement())
  enrollmentId                Int
  enrollment                  Enrollment           @relation(fields: [enrollmentId], references: [id])
  collectorId                 Int?
  collector                   User?                @relation("PaymentCollector", fields: [collectorId], references: [id], onDelete: SetNull)
  registeredBranchId          Int?
  amount                      Decimal              @db.Decimal(12, 2)
  paymentDate                 DateTime             @db.Date
  paymentMethod               PaymentMethod
  reference                   String?
  notes                       String?
  payerName                   String?
  payerDocumentType           ReceiptDocumentType?
  payerDocumentNumber         String?
  payerRelationship           ReceiptRelationship?
  payerRelationshipOther      String?
  paymentEvidenceKey          String?
  paymentEvidenceOriginalName String?
  paymentEvidenceMimeType     String?
  paymentEvidenceStorage      String?
  receiptNumber               String?              @unique
  receiptGeneratedAt          DateTime?
  createdAt                   DateTime             @default(now())
  branchName                  String?
  groupName                   String?

  @@index([enrollmentId, paymentDate])
  @@index([collectorId, paymentDate])
  @@index([registeredBranchId, paymentDate])
}

model ReceiptCounter {
  year      Int      @id
  lastValue Int
  updatedAt DateTime @updatedAt
}

model VoucherCounter {
  academicCycleId Int
  studentId       Int
  lastValue       Int           @default(0)
  updatedAt       DateTime      @updatedAt
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([academicCycleId, studentId])
}

model EnrollmentFee {
  cycles      AcademicCycle[]
  id          Int             @id @default(autoincrement())
  cycleGroups CycleGroup[]
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  validFrom   DateTime        @db.Date
  validUntil  DateTime?       @db.Date
  createdAt   DateTime        @default(now())
  enrollments Enrollment[]
}

model Pension {
  id          Int          @id @default(autoincrement())
  name        String
  amount      Decimal      @db.Decimal(12, 2)
  dueDay      Int
  isActive    Boolean      @default(true)
  cycleGroups CycleGroup[]
}
